# Server HTTP port
PORT=8080

# SQLite database path (single file + WAL mode)
MODL_DB_PATH=./data/modl.db

# Local filesystem path for uploaded media, icons, and evidence files
MODL_STORAGE_DIR=./data/storage

# Base domain for panel/public requests
MODL_DOMAIN=localhost

# Single-tenant mode: automatically falls back to your default server if Host header doesn't match
MODL_SINGLE_TENANT=true

# First-boot auto-bootstrap (creates your server & admin account automatically if DB is empty)
MODL_BOOTSTRAP_SERVER_NAME=My Minecraft Server
MODL_BOOTSTRAP_DOMAIN=localhost
MODL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional: set a fixed Minecraft plugin API key, or leave empty to auto-generate on first boot
MODL_BOOTSTRAP_API_KEY=

# Security secrets (auto-generated securely if left empty, recommended to set in production)
MODL_AUTH_CODE_HASH_SECRET=
MODL_SESSION_COOKIE_NAME=MODL_SESSION
MODL_COOKIE_SECURE=false

# Optional SMTP for login codes & ticket verification emails
# If SMTP_HOST is empty, login codes are printed to stdout logs!
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
MODL_EMAIL_DOMAIN=localhost

# Optional Gemini AI moderation suggestions
GEMINI_API_KEY=
MODL_GEMINI_MODEL_ID=gemini-2.5-flash-lite

# Optional external panel dist directory (leave empty to use embedded UI)
MODL_PANEL_DIST_DIR=
